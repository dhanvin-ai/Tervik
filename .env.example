# Local development needs no environment file. Copy this only to customize it.
DATABASE_URL=sqlite:///./.data/tervik.db
# Optional administrator authentication for dashboard APIs. Never use a project ingest key here.
# TERVIK_ADMIN_TOKEN=replace-with-a-long-random-value
# Demo loading defaults off when an administrator token is configured.
# TERVIK_DEMO_ENABLED=false
# Optional analytical event mirror. Local dashboard queries still use the SQL database.
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_USER=tervik
# CLICKHOUSE_PASSWORD=replace-with-a-long-random-value
# CLICKHOUSE_DATABASE=tervik
# Phase 2: durable transport and workers. Unset = local DB outbox only.
# NATS_URL=nats://127.0.0.1:4222
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=tervik-payloads
# Set false to simulate worker outage (jobs stay pending until a worker runs).
# TERVIK_INLINE_PROCESS=true
